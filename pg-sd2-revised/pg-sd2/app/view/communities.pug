extends index.pug

block content
    h1= `Communities list`

    table
        tr
            th ID
            th Name
            th Description
            th Actions
            th View

        each community in communities
            tr
                td= community && community.id ? community.id : 'N/A'
                td
                    a(href=`./community/${community.id}`)= community.name
                td= community && community.description ? community.description : 'N/A'
                td
                    if joinedIds.includes(community.id)
                        span(style="color: green") Joined ✅
                    else
                        span(style="color: gray") Not Joined
                td
                    if !joinedIds.includes(community.id)
                        form(action=`/community/join-community/${community.id}`, method="POST")
                            button(type="submit") Join
                    else
                        span N/A