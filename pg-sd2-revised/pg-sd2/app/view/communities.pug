extends index.pug

block content
    h1= `Communities list`

    table
        tr
          th ID
          th Name
          th Description
          th Actions

        each community in communities
            tr
              td= community && community._id ? community._id : 'N/A'
              td= community && community._name ? community._name : 'N/A'
              td= community && community._description ? community._description : 'N/A'
              td
                a(href=`/community/${community.id}`) View Community