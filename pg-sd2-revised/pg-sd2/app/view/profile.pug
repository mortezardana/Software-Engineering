extends index
include components/_activityCard.pug
include components/_postCard.pug

block content
    .profile-container
        .profile-header
            img.profile-pic(src=member.avatar || "/images/default-avatar.png", alt="avatar")
            h1 #{member.name || member.username}
            p= member.bio || "No bio provided."

        .stats-section
            h2 Lifetime Stats
            ul.stats-list
                li Total Distance: #{stats.totalDistance} km
                li Total Time: #{stats.totalTime} minutes
                li Average Speed: #{stats.avgSpeed} km/h
                li Total Elevation: #{stats.totalElevation} m
                li Activities Logged: #{activities.length}

        .profile-columns
            .left-column
                h2 Recent Activities
                if activities.length
                    each activity in activities
                        +activityCard(activity)
                else
                    p No activities yet.

                if hasMore
                    form(action=`/member/profile/${member.username}/activities`, method="get")
                        button(type="submit").btn-primary Show More

            .right-column
                h2 Posts
                if posts.length
                    each post in posts
                        +postCard(post)
                else
                    p No posts yet.
