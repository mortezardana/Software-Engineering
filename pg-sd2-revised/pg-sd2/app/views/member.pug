extends index.pug

block content
  h1 Member Profile

  table
    tr
      th ID
      th Username
      th Name
      th Email
      th Activities
      th Comments
      th Communities
      th Posts
    tr
      td= member && member.id ? member.id : 'N/A'
      td= member && member.username ? member.username : 'N/A'
      td= member && member.name ? member.name : 'N/A'
      td= member && member.email ? member.email : 'N/A'
      td
        a(href=`/activities/${member.username}`) View Activities
      td
        a(href=`/comments/${member.username}`) View Comments
      td
        a(href=`/member-communities/${member.id}`) View Communities
      td
        a(href=`/posts/${member.username}`) View Posts

  // Create Post button below the table
  .post-button-container
    a.btn-create-post(href="/create-post") + Create Post

  style.
    .post-button-container {
      margin-top: 20px;
    }

    .btn-create-post {
      background: #50E673;
      color: white;
      padding: 10px 20px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: bold;
      font-size: 1rem;
      display: inline-block;
      transition: background-color 0.3s ease;
    }

    .btn-create-post:hover {
      background-color: #3ac662;
    }
