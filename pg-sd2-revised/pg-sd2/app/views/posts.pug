extends index.pug

block content
  h1= `${member.username}'s Posts`

  table
    tr
      th ID
      th Date
      th Text
      th Image
      th Community ID
      th Member ID
      th Activity ID
      th Edit
      th Delete

    each post in posts
      tr
        td= post.id || 'N/A'
        td= post.date || 'N/A'
        td= post.text || 'N/A'

        // Show image if it exists
        td
          if post.image
            img(src=`/uploads/${post.image}`, alt="Post image", style="max-width: 150px; border-radius: 10px;")
          else
            i No image

        td
          if post.community_id
            a(href=`/community/${post.community_id}`) View Community
          else
            i No community

        td
          a(href=`/member/${member.username}`) View Profile

        td
          if post.activity_id
            a(href=`/activity/${post.activity_id}/${member.username}`) View Activity
          else
            i No activity

        // Edit button
        td
          a.btn-edit(href=`/edit-post/${post.id}`) Edit

        // Delete button with confirmation
        td
          form(method="POST", action=`/delete-post/${post.id}`, onsubmit="return confirm('Are you sure you want to delete this post?');")
            button.btn-delete(type="submit") Delete

  style.
    .btn-edit, .btn-delete {
      padding: 6px 12px;
      border-radius: 6px;
      font-weight: bold;
      font-size: 0.9rem;
      text-decoration: none;
      display: inline-block;
    }

    .btn-edit {
      background-color: #3498db;
      color: white;
    }

    .btn-edit:hover {
      background-color: #2980b9;
    }

    .btn-delete {
      background-color: #e74c3c;
      color: white;
      border: none;
      cursor: pointer;
    }

    .btn-delete:hover {
      background-color: #c0392b;
    }
