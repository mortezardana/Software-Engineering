extends index.pug

block content
  h1 Communities list

  table
    thead
      tr
        th ID 
        th Name
        th Description
        th Status
        th Actions
    tbody
      each community in communities
        tr
          td= community.id
          td 
            a(href=`/community/${community.id}`)= community.name
          td= community.description
          td
            if joinedIds.includes(community.id)
              span(style="color: green") Joined ✅
            else
              span(style="color: gray") Not Joined
          td
            if !joinedIds.includes(community.id)
              form(action=`/join-community/${community.id}`, method="POST")
                button(type="submit") Join
            else
              span N/A
